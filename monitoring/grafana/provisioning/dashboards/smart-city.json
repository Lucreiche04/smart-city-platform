    {
      "id": 16,
      "type": "timeseries",
      "title": "PM2.5 moyen et trafic",
      "description": "",
      "datasource": {
        "uid": "smartcitydb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "rawSql": "SELECT time_bucket('1 hour', time) AS time, avg(value) AS \"PM2.5 (µg/m³)\" FROM measurements WHERE pollutant = 'pm25' AND NOT is_anomaly AND $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "uid": "smartcitydb"
          }
        },
        {
          "rawSql": "SELECT time, traffic_index AS \"Trafic (0-100)\" FROM mobility WHERE $__timeFilter(time) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "B",
          "datasource": {
            "uid": "smartcitydb"
