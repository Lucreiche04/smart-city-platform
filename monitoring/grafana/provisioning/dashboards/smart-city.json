    {
      "id": 15,
      "type": "timeseries",
      "title": "Mesures reçues par heure et par source",
      "description": "Une source qui tombe à zéro = collecte ou capteur en panne",
      "datasource": {
        "uid": "smartcitydb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "rawSql": "SELECT time_bucket('1 hour', time) AS time, source AS metric, count(*) AS value FROM measurements WHERE $__timeFilter(time) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "uid": "smartcitydb"
          }
