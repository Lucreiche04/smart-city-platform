    {
      "id": 11,
      "type": "stat",
      "title": "Minutes depuis la dernière collecte AQICN",
      "description": "La collecte a lieu toutes les heures : au-delà de 90 min, vérifier le token AQICN et les logs",
      "datasource": {
        "uid": "smartcitydb"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "rawSql": "SELECT round(extract(epoch FROM now() - max(time)) / 60) AS minutes FROM measurements WHERE source = 'aqicn'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "uid": "smartcitydb"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
