# Domaine public (sur le VPS) ; "localhost" en local -> certificat auto-signé de Caddy
DOMAIN=localhost

# Base de données
POSTGRES_USER=smartcity
POSTGRES_PASSWORD=change_me_db
POSTGRES_DB=smartcity

# Clés API gratuites
AQICN_TOKEN=demo                 # https://aqicn.org/data-platform/token/
OPENWEATHER_API_KEY=             # https://home.openweathermap.org/api_keys
CITY_NAME=Paris
CITY_LAT=48.8566
CITY_LON=2.3522

# Sécurité
JWT_SECRET=change_me_with_a_long_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
IOT_API_KEY=change_me_iot        # clé partagée pour l'ingestion HTTP POST

# Emails (Mailpit en local : host=mailpit port=1025 sans auth)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertes@smartcity.local
ALERT_EMAILS=marie.dubois@metropole.local

# Simulateur IoT
SIM_INTERVAL_SECONDS=900          # 15 min (mettre 10 pour une démo rapide)
SIM_SPIKE_PROBABILITY=0.03        # probabilité d'une valeur aberrante

GRAFANA_PASSWORD=change_me_grafana
